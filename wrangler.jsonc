{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-10-03",
  "main": "worker/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    // The worker runs first so it can redirect haddow.me and add headers.
    "run_worker_first": true,
  },
  "routes": [
    { "pattern": "jon.haddow.me", "custom_domain": true },
    { "pattern": "haddow.me", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
}
